name: verify
on:
  push:
    branches: ["**"]
  pull_request:
    branches: ["**"]

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - name: Install (no deps, but ensure lock)
        run: npm install --package-lock-only --ignore-scripts 2>&1 | tail -n 20 || echo "no lock needed"
      - name: Syntax check (node --check)
        run: npm run check
      - name: Tests (node --test)
        run: npm test
      - name: Verify (check + test)
        run: npm run verify
      - name: Coverage metrics (from export)
        run: node -e "import fs from 'fs'; console.log('dist size', fs.statSync('dist/generic-discovery-engine.user.js').size, 'lines', fs.readFileSync('dist/generic-discovery-engine.user.js','utf8').split('\n').length)"
