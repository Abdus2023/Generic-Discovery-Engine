name: verify
on:
  push:
    branches: ["**"]
  pull_request:
    branches: ["**"]

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - name: Install deps (for c8 gate; no runtime deps otherwise)
        run: npm install 2>&1 | tail -n 20
      - name: Syntax check (node --check)
        run: npm run check
      - name: Lint (flat config, no warn)
        run: npm run lint
      - name: Tests (node --test)
        run: npm test
      - name: Verify (check + test)
        run: npm run verify
      - name: Coverage gate (c8 85/75/80)
        run: npm run coverage:check
      - name: Typecheck (tsc --noEmit, informational)
        run: npm run typecheck 2>&1 | tail -n 50 || echo "typecheck informational"
      - name: Coverage metrics (dist size + native)
        run: |
          node -e "import fs from 'fs'; console.log('dist size', fs.statSync('dist/generic-discovery-engine.user.js').size, 'lines', fs.readFileSync('dist/generic-discovery-engine.user.js','utf8').split('\n').length)"
          npm run coverage 2>&1 | tail -n 20
