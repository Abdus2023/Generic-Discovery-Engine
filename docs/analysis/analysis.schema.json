{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generic-discovery-analysis.schema.json",
  "$comment": "The $id above is intentionally non-authoritative; replace it with the project's schema namespace if this schema is ever published. The object shapes are normative (sections 185-197). Additional properties are permitted: the schema fixes the typed fields, it does not forbid extensions. Capability references accept both the object form and the bare-id shorthand of section 154; operation targets accept both a path string and a resource-classed object. Semantic rules that JSON Schema cannot express are enforced by tools/validate-analysis.mjs: claim rules C-001…C-043 and matrix CV-001…CV-020, capability rules AC-001…AC-016, execution-verification rules EVV-001…EVV-009, lifecycle transitions (section 200), serialization invariants SER-001…SER-012 and invariants I-001…I-016. The terms \"status\" and unqualified \"verification\" are not field names in this schema (section 168).",
  "title": "Generic Discovery Engine Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "scope",
    "claims",
    "changes",
    "authorization",
    "execution",
    "execution_verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "level_profiles": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        }
      },
      "$comment": "Embedded policy registry (section 185 permits embedding): profile id -> {id, inherits, capabilities}."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "$comment": "Embedded policy registry: capability definitions with state DECLARED. A declared capability is not enabled (AC-005); the authorization's grants/denies carry the states that matter for a decision."
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "authorization_grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorization"
      },
      "$comment": "Additional grants in the canonical authorization shape. No profile carries both documentation mutation and publication as a narrow grant, so each authority is recorded separately and restricted by capabilities."
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "execution_verification": {
      "$ref": "#/$defs/execution_verification"
    },
    "absence_verification": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        }
      },
      "$comment": "Roles, withheld capability classes and forbidden operations, kept outside the canonical authorization object."
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "claim_kind",
        "implementation_state",
        "test_state",
        "evidence_level",
        "claim_verification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3,}$",
          "$comment": "Project convention <FAMILY>-CLAIM-<nnn>. Renaming the 41 identifiers cited across 22 documents would break the stable-id requirement, so the pattern is tightened to the established convention."
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_kind": {
          "enum": [
            "CURRENT",
            "SPECIFIED",
            "PLANNED",
            "HISTORICAL",
            "HYPOTHESIS",
            "NON_GOAL"
          ]
        },
        "implementation_state": {
          "enum": [
            "IMPLEMENTED",
            "PARTIAL",
            "NOT_IMPLEMENTED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "test_state": {
          "enum": [
            "TESTED",
            "PARTIALLY_TESTED",
            "UNTESTED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "evidence_level": {
          "enum": [
            "DIRECT",
            "CORROBORATED",
            "INDIRECT",
            "ABSENT",
            "INACCESSIBLE"
          ]
        },
        "claim_verification": {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "enum": [
                "VERIFIED",
                "PARTIALLY_VERIFIED",
                "UNVERIFIED",
                "CONTRADICTED",
                "NOT_APPLICABLE"
              ]
            },
            "method": {
              "type": "string",
              "$comment": "How the result was established when that is not self-evident from the evidence list."
            }
          },
          "$comment": "Section 168.1: the object being verified is the claim. A bare 'verification' field is forbidden because it does not say what is verified."
        },
        "confidence": {
          "enum": [
            "VERY_LOW",
            "LOW",
            "MEDIUM",
            "HIGH",
            "VERY_HIGH"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "interpretation": {
          "type": "object",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "absence_verification": {
          "type": "string",
          "$comment": "Procedure id; required when evidence_level is ABSENT and the claim is VERIFIED."
        },
        "absence_test": {
          "type": "string"
        },
        "conflicting_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "CODE",
            "TEST",
            "CONFIG",
            "DOCUMENTATION",
            "HISTORY",
            "GENERATED_ARTIFACT",
            "EXTERNAL_REFERENCE"
          ]
        },
        "path": {
          "type": "string"
        },
        "locator": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "LINE_RANGE",
                "SYMBOL",
                "HEADING",
                "SECTION",
                "COMMIT",
                "TAG",
                "URL",
                "FILE"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      },
      "$comment": "No generic \"status\" property is permitted (section 189)."
    },
    "repository": {
      "type": "object",
      "required": [
        "owner",
        "name",
        "requested_revision",
        "resolved_revision",
        "access_level"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "requested_revision": {
          "type": "string"
        },
        "resolved_revision": {
          "type": "string"
        },
        "access_level": {
          "enum": [
            "FULL",
            "PARTIAL",
            "DOCUMENT_ONLY",
            "SEARCH_ONLY",
            "NONE"
          ]
        },
        "included_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "boolean"
        },
        "source_code": {
          "type": "boolean"
        },
        "tests": {
          "type": "boolean"
        },
        "configuration": {
          "type": "boolean"
        },
        "documentation": {
          "type": "boolean"
        },
        "history": {
          "type": "boolean"
        },
        "external_dependencies": {
          "type": "boolean"
        },
        "runtime_environment": {
          "type": "boolean"
        },
        "paths": {
          "$ref": "#/$defs/paths"
        }
      },
      "$comment": "Section 187. The boolean dimensions declare what the analysis covered; scope.paths declares the locations."
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "category",
        "description",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "DOC_CLEANUP",
            "DOC_MOVE",
            "DOC_MERGE",
            "DOC_SPLIT",
            "DOC_REWRITE",
            "CODE_REFACTOR",
            "CODE_FIX",
            "TEST_ADD",
            "TEST_UPDATE",
            "ARCHITECTURE_CHANGE",
            "REMOVAL",
            "RENAME"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "object",
          "properties": {
            "paths": {
              "$ref": "#/$defs/paths"
            }
          }
        },
        "risk": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "state",
        "resource_class",
        "operations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CAP-[A-Z0-9_-]+$"
        },
        "state": {
          "enum": [
            "DECLARED",
            "ENABLED",
            "RESTRICTED",
            "DENIED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "resource_class": {
          "enum": [
            "REPOSITORY",
            "DOCUMENT",
            "TEST",
            "SOURCE",
            "CONFIGURATION",
            "ARCHITECTURE",
            "COMMIT",
            "REMOTE"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "READ",
              "ANALYZE",
              "PROPOSE",
              "CREATE",
              "MODIFY",
              "RENAME",
              "MOVE",
              "DELETE",
              "COMMIT",
              "PUSH"
            ]
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "paths": {
              "$ref": "#/$defs/paths"
            }
          }
        }
      },
      "$comment": "Sections 172/191. Atomic authorization primitive: one resource class, a set of operations, optional constraints and a lifecycle state. DECLARED is not ENABLED (AC-005)."
    },
    "level_profile": {
      "type": "object",
      "required": [
        "id",
        "inherits",
        "capabilities"
      ],
      "properties": {
        "id": {
          "enum": [
            "READ_ONLY",
            "ANALYSIS_ONLY",
            "DOC_REFACTOR",
            "TEST_REFACTOR",
            "CODE_REFACTOR",
            "ARCHITECTURE_CHANGE",
            "COMMIT",
            "PUSH"
          ]
        },
        "inherits": {
          "type": "array",
          "items": {
            "enum": [
              "READ_ONLY",
              "ANALYSIS_ONLY",
              "DOC_REFACTOR",
              "TEST_REFACTOR",
              "CODE_REFACTOR",
              "ARCHITECTURE_CHANGE",
              "COMMIT",
              "PUSH"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CAP-[A-Z0-9_-]+$"
          }
        }
      },
      "$comment": "Sections 173/192. A reusable policy definition, not an authorization. Inheritance must be declared and acyclic."
    },
    "authorization": {
      "type": "object",
      "required": [
        "state",
        "level",
        "change_ids"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_REQUESTED",
            "REQUESTED",
            "GRANTED",
            "DENIED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "level": {
          "type": "object",
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "enum": [
                "READ_ONLY",
                "ANALYSIS_ONLY",
                "DOC_REFACTOR",
                "TEST_REFACTOR",
                "CODE_REFACTOR",
                "ARCHITECTURE_CHANGE",
                "COMMIT",
                "PUSH"
              ]
            }
          }
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "PROFILE_DEFAULT",
                "RESTRICT"
              ]
            },
            "grants": {
              "type": "array",
              "items": {
                "$comment": "Section 154/193 accepts a capability reference either as the full object form (id, state, resource_class, operations, constraints) or as a bare capability id drawn from the embedded catalogue. The bare form is shorthand: in grants it means ENABLED, in denies DENIED. This record uses the object form because it must carry states, resource classes and path constraints.",
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^CAP-[A-Z0-9_-]+$"
                  },
                  {
                    "$ref": "#/$defs/capability"
                  }
                ]
              }
            },
            "denies": {
              "type": "array",
              "items": {
                "$comment": "Section 154/193 accepts a capability reference either as the full object form (id, state, resource_class, operations, constraints) or as a bare capability id drawn from the embedded catalogue. The bare form is shorthand: in grants it means ENABLED, in denies DENIED. This record uses the object form because it must carry states, resource classes and path constraints.",
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^CAP-[A-Z0-9_-]+$"
                  },
                  {
                    "$ref": "#/$defs/capability"
                  }
                ]
              }
            }
          },
          "$comment": "Section 193. grants/denies are capability objects, each with its own state. A grant may not introduce a capability absent from the profile closure (AC-007); an explicit deny overrides an explicit grant (AC-008)."
        },
        "operations": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "enum": [
                  "READ",
                  "ANALYZE",
                  "PROPOSE",
                  "CREATE",
                  "MODIFY",
                  "RENAME",
                  "MOVE",
                  "DELETE",
                  "COMMIT",
                  "PUSH"
                ]
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "enum": [
                  "READ",
                  "ANALYZE",
                  "PROPOSE",
                  "CREATE",
                  "MODIFY",
                  "RENAME",
                  "MOVE",
                  "DELETE",
                  "COMMIT",
                  "PUSH"
                ]
              }
            }
          },
          "$comment": "Operation lists may restrict profile authority and must never expand it (AC-009, AC-010)."
        },
        "change_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "type": "object",
          "required": [
            "type",
            "identifier"
          ],
          "properties": {
            "type": {
              "enum": [
                "USER",
                "ROLE",
                "POLICY"
              ]
            },
            "identifier": {
              "type": "string"
            }
          }
        },
        "target": {
          "type": "object",
          "required": [
            "repository",
            "revision"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          }
        },
        "scope": {
          "type": "object",
          "properties": {
            "paths": {
              "$ref": "#/$defs/paths"
            }
          }
        },
        "granted_at": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "$comment": "Sections 177/193. Canonical field names (no variants): state, level, capabilities, operations, change_ids, authority, target, scope, granted_at, expires_at."
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "target",
        "authorization_decision",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "change_id": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "READ",
            "ANALYZE",
            "PROPOSE",
            "CREATE",
            "MODIFY",
            "RENAME",
            "MOVE",
            "DELETE",
            "COMMIT",
            "PUSH"
          ]
        },
        "target": {
          "$comment": "Section 161 shows a path string; this record uses the object form so the resource class is explicit and the capability that authorized the operation can be resolved mechanically (section 172: a capability is bound to one resource class).",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "resource_class"
              ],
              "properties": {
                "resource_class": {
                  "enum": [
                    "REPOSITORY",
                    "DOCUMENT",
                    "TEST",
                    "SOURCE",
                    "CONFIGURATION",
                    "ARCHITECTURE",
                    "COMMIT",
                    "REMOTE"
                  ]
                },
                "path": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "authorization_decision": {
          "enum": [
            "ALLOWED",
            "DENIED"
          ]
        },
        "result": {
          "enum": [
            "NOT_ATTEMPTED",
            "AUTHORIZATION_DENIED",
            "SKIPPED",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "BLOCKED"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "$comment": "Section 194. A resource class prevents MODIFY from becoming an unconstrained permission."
    },
    "execution": {
      "type": "object",
      "required": [
        "state",
        "operations",
        "executed_changes",
        "unauthorized_changes"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_STARTED",
            "AUTHORIZATION_BLOCKED",
            "READY",
            "RUNNING",
            "SUCCEEDED",
            "PARTIALLY_SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "STOPPED"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "executed_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unauthorized_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discovered_not_executed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "$comment": "Section 195. execution.state describes the process; it does not describe whether the resulting repository is correct (section 180)."
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "description",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "result": {
          "enum": [
            "NOT_RUN",
            "PASSED",
            "FAILED",
            "BLOCKED",
            "INCONCLUSIVE"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "$comment": "Section 196. One check has one outcome: check.result, never a lifecycle state."
    },
    "execution_verification": {
      "type": "object",
      "required": [
        "state",
        "result",
        "checks"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_REQUIRED",
            "NOT_STARTED",
            "READY",
            "RUNNING",
            "PASSED",
            "PARTIALLY_PASSED",
            "FAILED",
            "BLOCKED",
            "INCONCLUSIVE"
          ]
        },
        "result": {
          "enum": [
            "CONFORMING",
            "PARTIALLY_CONFORMING",
            "NON_CONFORMING",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "remediation_required": {
          "type": "boolean"
        },
        "independent": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "$comment": "Must be empty: execution verification never modifies the repository (EVV-008)."
        },
        "not_verified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "$comment": "Sections 168.2/197. Distinct from claim verification and from execution: state is the verification lifecycle, result is its conclusion about the post-execution repository."
    }
  },
  "capability_registry_comment": "Canonical capability catalogue: id, resource class and the operations the capability can authorize against that class (sections 172, 176). An authorization selects from this catalogue and can never invent an id.",
  "resource_class_comment": "REPOSITORY, DOCUMENT, TEST, SOURCE, CONFIGURATION, ARCHITECTURE, COMMIT, REMOTE (section 176). CAP-DOCUMENT-MODIFY means MODIFY against DOCUMENT, not MODIFY against an arbitrary repository object.",
  "level_profiles": {
    "READ_ONLY": {
      "id": "READ_ONLY",
      "inherits": [],
      "capabilities": [
        "CAP-REPOSITORY-READ"
      ]
    },
    "ANALYSIS_ONLY": {
      "id": "ANALYSIS_ONLY",
      "inherits": [
        "READ_ONLY"
      ],
      "capabilities": [
        "CAP-REPOSITORY-ANALYZE",
        "CAP-REPOSITORY-PROPOSE"
      ]
    },
    "DOC_REFACTOR": {
      "id": "DOC_REFACTOR",
      "inherits": [
        "ANALYSIS_ONLY"
      ],
      "capabilities": [
        "CAP-DOCUMENT-CREATE",
        "CAP-DOCUMENT-MODIFY",
        "CAP-DOCUMENT-RENAME",
        "CAP-DOCUMENT-MOVE",
        "CAP-DOCUMENT-DELETE"
      ]
    },
    "TEST_REFACTOR": {
      "id": "TEST_REFACTOR",
      "inherits": [
