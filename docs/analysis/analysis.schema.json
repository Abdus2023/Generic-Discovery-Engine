{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generic-discovery-analysis.schema.json",
  "$comment": "The $id above is intentionally non-authoritative; replace it with the project's schema namespace if this schema is ever published. Additional properties are permitted throughout: the schema fixes the typed fields, it does not forbid extensions. Semantic rules that JSON Schema cannot express are enforced by tools/validate-analysis.mjs: claim rules C-001…C-043, validation matrix CV-001…CV-020, execution invariants EV-001…EV-012, post-verification invariants PV-001…PV-010, authorization rules AUTH-001…AUTH-020, serialization invariants SER-001…SER-012 and invariants I-001…I-016.",
  "title": "Generic Discovery Engine Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "scope",
    "claims",
    "changes",
    "authorization",
    "execution",
    "post_verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "authorization_grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorization"
      },
      "$comment": "Additional grants, each in the canonical authorization shape. A level profile is a ceiling, not an authority: no single profile carries both documentation mutation and publication as a narrow grant, so the publication capability is recorded as its own grant, restricted by capabilities.allow/deny."
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "post_verification": {
      "$ref": "#/$defs/post_verification"
    },
    "absence_verification": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "$comment": "Declared-scope absence procedures referenced by claims (CV-010)."
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "governance": {
      "type": "object",
      "$comment": "Roles, withheld capability classes and forbidden operations, kept outside the canonical authorization object."
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "claim_kind",
        "implementation_state",
        "test_state",
        "evidence_level",
        "verification_result",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3,}$",
          "$comment": "Project convention: <FAMILY>-CLAIM-<nnn> (CAND-CLAIM-001). The template pattern ^[A-Z]+-[0-9]{3,}$ would require renaming 41 identifiers already cited across 22 documents; identifier stability takes precedence, so the pattern is tightened to the established convention instead."
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_kind": {
          "enum": [
            "CURRENT",
            "SPECIFIED",
            "PLANNED",
            "HISTORICAL",
            "HYPOTHESIS",
            "NON_GOAL"
          ]
        },
        "implementation_state": {
          "enum": [
            "IMPLEMENTED",
            "PARTIAL",
            "NOT_IMPLEMENTED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "test_state": {
          "enum": [
            "TESTED",
            "PARTIALLY_TESTED",
            "UNTESTED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "evidence_level": {
          "enum": [
            "DIRECT",
            "CORROBORATED",
            "INDIRECT",
            "ABSENT",
            "INACCESSIBLE"
          ]
        },
        "verification_result": {
          "enum": [
            "VERIFIED",
            "PARTIALLY_VERIFIED",
            "UNVERIFIED",
            "CONTRADICTED",
            "NOT_APPLICABLE"
          ]
        },
        "confidence": {
          "enum": [
            "VERY_LOW",
            "LOW",
            "MEDIUM",
            "HIGH",
            "VERY_HIGH"
          ],
          "$comment": "Optional graded assessment of evidential strength (section 141). It never replaces evidence_level or verification_result. This repository assigns it by rule: HIGH = DIRECT|CORROBORATED evidence joined by an executed test with a verification result other than UNVERIFIED; MEDIUM = DIRECT|CORROBORATED without execution, an ABSENT claim with a recorded procedure, or any UNVERIFIED claim; LOW = INDIRECT; VERY_LOW = INACCESSIBLE. The confusing combination HIGH/VERY_HIGH with UNVERIFIED is rejected by the validator."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "interpretation": {
          "type": "object",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "$comment": "What the evidence does not establish: bounded scope, harness limits, unresolved conflict."
            }
          }
        },
        "absence_verification": {
          "type": "string",
          "$comment": "References an absence_verification procedure; required when evidence_level is ABSENT and verification_result is VERIFIED (CV-010)."
        },
        "absence_test": {
          "type": "string",
          "$comment": "Set when implementation_state is NOT_IMPLEMENTED and test_state is TESTED: names the executed test that establishes the absence."
        },
        "conflicting_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "$comment": "Evidence ids that conflict with the claim; required when verification_result is CONTRADICTED and the conflict is not expressed as a claim-to-claim contradiction (CV-008)."
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "locator"
      ],
      "$comment": "No generic \"status\" field is permitted on evidence (section 143).",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "CODE",
            "TEST",
            "CONFIG",
            "DOCUMENTATION",
            "HISTORY",
            "GENERATED_ARTIFACT",
            "EXTERNAL_REFERENCE"
          ]
        },
        "path": {
          "type": "string"
        },
        "locator": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "LINE_RANGE",
                "SYMBOL",
                "HEADING",
                "SECTION",
                "COMMIT",
                "TAG",
                "URL",
                "FILE"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "owner",
        "name",
        "requested_revision",
        "resolved_revision",
        "access_level"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "requested_revision": {
          "type": "string"
        },
        "resolved_revision": {
          "type": "string"
        },
        "access_level": {
          "enum": [
            "FULL",
            "PARTIAL",
            "DOCUMENT_ONLY",
            "SEARCH_ONLY",
            "NONE"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "category",
        "description",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "DOC_CLEANUP",
            "DOC_MOVE",
            "DOC_MERGE",
            "DOC_SPLIT",
            "DOC_REWRITE",
            "CODE_REFACTOR",
            "CODE_FIX",
            "TEST_ADD",
            "TEST_UPDATE",
            "ARCHITECTURE_CHANGE",
            "REMOVAL",
            "RENAME"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "INHERIT",
            "RESTRICT"
          ],
          "$comment": "INHERIT takes the profile capability set unchanged; RESTRICT intersects it with allow and then subtracts deny."
        },
        "allow": {
          "type": "array",
          "items": {
            "enum": [
              "REPOSITORY_READ",
              "ANALYSIS_EXECUTE",
              "PROPOSAL_CREATE",
              "DOCUMENT_CREATE",
              "DOCUMENT_MODIFY",
              "DOCUMENT_RENAME",
              "DOCUMENT_MOVE",
              "DOCUMENT_DELETE",
              "TEST_CREATE",
              "TEST_MODIFY",
              "TEST_RENAME",
              "TEST_MOVE",
              "TEST_DELETE",
              "CODE_CREATE",
              "CODE_MODIFY",
              "CODE_RENAME",
              "CODE_MOVE",
              "CODE_DELETE",
              "ARCHITECTURE_MODIFY",
              "COMMIT_CREATE",
              "PUSH_EXECUTE"
            ]
          },
          "$comment": "Section 152: allow MUST NOT introduce a capability the profile does not contain."
        },
        "deny": {
          "type": "array",
          "items": {
            "enum": [
              "REPOSITORY_READ",
              "ANALYSIS_EXECUTE",
              "PROPOSAL_CREATE",
              "DOCUMENT_CREATE",
              "DOCUMENT_MODIFY",
              "DOCUMENT_RENAME",
              "DOCUMENT_MOVE",
              "DOCUMENT_DELETE",
              "TEST_CREATE",
              "TEST_MODIFY",
              "TEST_RENAME",
              "TEST_MOVE",
              "TEST_DELETE",
              "CODE_CREATE",
              "CODE_MODIFY",
              "CODE_RENAME",
              "CODE_MOVE",
              "CODE_DELETE",
              "ARCHITECTURE_MODIFY",
              "COMMIT_CREATE",
              "PUSH_EXECUTE"
            ]
          },
          "$comment": "Section 153: deny always wins over allow and over the profile."
        }
      },
      "$comment": "EffectiveCapabilities = (Capabilities(level.profile) intersect allow) minus deny."
    },
    "authorization": {
      "type": "object",
      "required": [
        "state",
        "level",
        "change_ids"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_REQUESTED",
            "REQUESTED",
            "DENIED",
            "GRANTED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "level": {
          "type": "object",
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "enum": [
                "READ_ONLY",
                "ANALYSIS_ONLY",
                "DOC_REFACTOR",
                "TEST_REFACTOR",
                "CODE_REFACTOR",
                "ARCHITECTURE_CHANGE",
                "COMMIT",
                "PUSH"
              ]
            }
          },
          "$comment": "A named policy profile, not an authority and not an operation list. Capabilities come from the profile closure."
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "operations": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "enum": [
                  "READ",
                  "ANALYZE",
                  "PROPOSE",
                  "CREATE",
                  "MODIFY",
                  "RENAME",
                  "MOVE",
                  "DELETE",
                  "COMMIT",
                  "PUSH"
                ]
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "enum": [
                  "READ",
                  "ANALYZE",
                  "PROPOSE",
                  "CREATE",
                  "MODIFY",
                  "RENAME",
                  "MOVE",
                  "DELETE",
                  "COMMIT",
                  "PUSH"
                ]
              },
              "$comment": "Operation-level deny: wins over allow."
            }
          },
          "$comment": "Operations are the execution-level abstraction; a capability authorizes an operation against a resource class."
        },
        "scope": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "object",
              "properties": {
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exclude": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "$comment": "Path prefixes or files inside the authorized change surface."
            }
          },
          "$comment": "Scope is a separate concept from level, capability and operation (section 167)."
        },
        "change_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "type": "object",
          "required": [
            "type",
            "identifier"
          ],
          "properties": {
            "type": {
              "enum": [
                "USER",
                "ROLE",
                "POLICY"
              ]
            },
            "identifier": {
              "type": "string"
            }
          }
        },
        "target": {
          "type": "object",
          "required": [
            "repository",
            "revision"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          }
        },
        "granted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "$comment": "Canonical field names (no variants): state, level, capabilities, operations, scope, change_ids, authority, target, granted_at, expires_at. Section 167: state is not level.profile, not capability, not operation, not scope, not change authorization. ALLOW = GRANTED and capability and operation and target and change in change_ids and temporal validity."
    },
    "execution": {
      "type": "object",
      "required": [
        "state",
        "operations",
        "executed_changes",
        "unauthorized_changes"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_STARTED",
            "AUTHORIZATION_BLOCKED",
            "READY",
            "RUNNING",
            "SUCCEEDED",
            "PARTIALLY_SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "STOPPED"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "operation",
              "target",
              "result"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "change_id": {
                "type": "string",
                "$comment": "The authorized change this operation belongs to (EV-011)."
              },
              "operation": {
                "enum": [
                  "READ",
                  "ANALYZE",
                  "PROPOSE",
                  "CREATE",
                  "MODIFY",
                  "RENAME",
                  "MOVE",
                  "DELETE",
                  "COMMIT",
                  "PUSH"
                ]
              },
              "target": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "NOT_ATTEMPTED",
                  "AUTHORIZATION_DENIED",
                  "SKIPPED",
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELLED",
                  "BLOCKED"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "$comment": "Per-operation result prevents execution.state = PARTIALLY_SUCCEEDED from hiding which operation failed (section 157)."
          }
        },
        "executed_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unauthorized_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discovered_not_executed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "$comment": "Execution has two levels: execution.state (lifecycle) and operations[].result (per operation). Neither is post-verification."
    },
    "post_verification": {
      "type": "object",
      "required": [
        "state",
        "result",
        "checks"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_REQUIRED",
            "NOT_STARTED",
            "READY",
            "RUNNING",
            "PASSED",
            "PARTIALLY_PASSED",
            "FAILED",
            "BLOCKED",
            "INCONCLUSIVE"
          ]
        },
        "result": {
          "enum": [
            "CONFORMING",
            "PARTIALLY_CONFORMING",
            "NON_CONFORMING",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ],
          "$comment": "Lifecycle state and outcome are separate fields; PV-006/PV-007 attach conformity to result, never to state."
        },
        "scope": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "result"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "NOT_RUN",
                  "PASSED",
                  "FAILED",
                  "BLOCKED",
                  "INCONCLUSIVE"
                ]
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "remediation_required": {
          "type": "boolean"
        },
        "independent": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "$comment": "Must be empty: post-verification never modifies the repository (PV-009)."
        },
        "not_verified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "$comment": "A distinct lifecycle. It does not reuse execution.state (sections 158-159)."
    },
    "operation_result": {
      "enum": [
        "NOT_ATTEMPTED",
        "AUTHORIZATION_DENIED",
        "SKIPPED",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "BLOCKED"
      ]
    },
    "capability": {
      "enum": [
        "REPOSITORY_READ",
        "ANALYSIS_EXECUTE",
        "PROPOSAL_CREATE",
        "DOCUMENT_CREATE",
        "DOCUMENT_MODIFY",
        "DOCUMENT_RENAME",
        "DOCUMENT_MOVE",
        "DOCUMENT_DELETE",
        "TEST_CREATE",
        "TEST_MODIFY",
        "TEST_RENAME",
        "TEST_MOVE",
        "TEST_DELETE",
        "CODE_CREATE",
        "CODE_MODIFY",
        "CODE_RENAME",
        "CODE_MOVE",
        "CODE_DELETE",
        "ARCHITECTURE_MODIFY",
        "COMMIT_CREATE",
        "PUSH_EXECUTE"
      ],
      "$comment": "An atomic permission. Capabilities are deliberately more granular than level profiles (section 146)."
    }
  },
  "level_profiles": {
    "READ_ONLY": {
      "inherits": [],
      "capabilities": [
        "REPOSITORY_READ"
      ]
    },
    "ANALYSIS_ONLY": {
      "inherits": [
        "READ_ONLY"
      ],
      "capabilities": [
        "ANALYSIS_EXECUTE",
        "PROPOSAL_CREATE"
      ]
    },
    "DOC_REFACTOR": {
      "inherits": [
        "ANALYSIS_ONLY"
      ],
      "capabilities": [
        "DOCUMENT_CREATE",
        "DOCUMENT_MODIFY",
        "DOCUMENT_RENAME",
        "DOCUMENT_MOVE",
        "DOCUMENT_DELETE"
      ]
    },
    "TEST_REFACTOR": {
      "inherits": [
        "ANALYSIS_ONLY"
      ],
      "capabilities": [
        "TEST_CREATE",
        "TEST_MODIFY",
        "TEST_RENAME",
        "TEST_MOVE",
        "TEST_DELETE"
      ]
    },
    "CODE_REFACTOR": {
      "inherits": [
        "ANALYSIS_ONLY"
      ],
      "capabilities": [
        "CODE_CREATE",
        "CODE_MODIFY",
        "CODE_RENAME",
        "CODE_MOVE",
        "CODE_DELETE"
      ]
    },
    "ARCHITECTURE_CHANGE": {
      "inherits": [
        "CODE_REFACTOR",
        "DOC_REFACTOR",
        "TEST_REFACTOR"
      ],
      "capabilities": [
        "ARCHITECTURE_MODIFY"
      ]
    },
    "COMMIT": {
      "inherits": [
        "ARCHITECTURE_CHANGE"
      ],
      "capabilities": [
        "COMMIT_CREATE"
      ]
    },
    "PUSH": {
      "inherits": [
        "COMMIT"
      ],
      "capabilities": [
        "PUSH_EXECUTE"
      ]
    }
  },
  "level_profiles_comment": "Capabilities(L) = OwnCapabilities(L) union Capabilities(parents), evaluated over the declared inherits edges. Inheritance is explicit and is never inferred from the textual ordering of level names (sections 148-150).",
  "capability_operations": {
    "REPOSITORY_READ": {
      "operation": "READ",
      "resource": "repository"
    },
    "ANALYSIS_EXECUTE": {
      "operation": "ANALYZE",
      "resource": "repository"
    },
    "PROPOSAL_CREATE": {
      "operation": "PROPOSE",
      "resource": "proposal"
    },
    "DOCUMENT_CREATE": {
      "operation": "CREATE",
      "resource": "documentation"
    },
    "DOCUMENT_MODIFY": {
      "operation": "MODIFY",
      "resource": "documentation"
    },
    "DOCUMENT_RENAME": {
      "operation": "RENAME",
      "resource": "documentation"
    },
    "DOCUMENT_MOVE": {
      "operation": "MOVE",
      "resource": "documentation"
    },
    "DOCUMENT_DELETE": {
      "operation": "DELETE",
      "resource": "documentation"
    },
    "TEST_CREATE": {
      "operation": "CREATE",
      "resource": "tests"
    },
    "TEST_MODIFY": {
      "operation": "MODIFY",
      "resource": "tests"
    },
    "TEST_RENAME": {
      "operation": "RENAME",
      "resource": "tests"
    },
    "TEST_MOVE": {
      "operation": "MOVE",
      "resource": "tests"
    },
    "TEST_DELETE": {
      "operation": "DELETE",
      "resource": "tests"
    },
    "CODE_CREATE": {
      "operation": "CREATE",
      "resource": "source_code"
    },
    "CODE_MODIFY": {
      "operation": "MODIFY",
      "resource": "source_code"
    },
    "CODE_RENAME": {
      "operation": "RENAME",
      "resource": "source_code"
    },
    "CODE_MOVE": {
      "operation": "MOVE",
      "resource": "source_code"
    },
    "CODE_DELETE": {
      "operation": "DELETE",
      "resource": "source_code"
    },
    "ARCHITECTURE_MODIFY": {
      "operation": "MODIFY",
      "resource": "architecture"
    },
    "COMMIT_CREATE": {
      "operation": "COMMIT",
      "resource": "repository"
    },
    "PUSH_EXECUTE": {
      "operation": "PUSH",
      "resource": "repository"
    }
  },
  "capability_operations_comment": "A capability authorizes one operation against one resource class (section 147). DOCUMENT_MODIFY permits MODIFY against documentation, not against arbitrary source code."
}
