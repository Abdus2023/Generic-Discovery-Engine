      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"
    },
    "scope_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,511}$"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "integrity_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"
    },
    "validated_subject_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"
    },
    "evaluator_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time"
    },
    "freshness_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"
    }
  },
  "additionalProperties": false,
  "x-authority-layer": "NORMATIVE_SPECIFICATION",
  "x-optional-fields": [],
  "x-identifier-type": "URI_SAFE_ASCII_DISTINCT_DOMAIN_NEWTYPE",
  "x-reference-integrity": "REFERENCES_MUST_RESOLVE_TO_EXPECTED_TYPE_AND_HASH",
  "x-cardinality": "ARRAY_BOUNDS_AND_UNIQUENESS_ENFORCED_BY_SCHEMA",
  "x-hash-input-fields": [
    "evaluation_context_id",
    "scope_ref",
    "effective_at",
    "evidence_refs",
    "integrity_refs",
    "profile_ref",
    "validated_subject_ref",
    "evaluator_ref",
    "evaluation_time",
    "freshness_ref"
  ],
  "x-hash-domain": "evaluation-context:v1",
  "x-canonicalization": "GDE-CJSON-1",
  "x-temporal-requirements": "RFC3339_UTC_Z_FIELDS_MUST_BE_VALIDATED_WHEN_PRESENT",
  "x-scope-requirements": "SCOPE_REFERENCES_MUST_BE_EXPLICIT_WHEN_OPERATION_IS_SCOPED",
  "x-integrity-requirements": "CONTENT_HASH_REQUIRED_SIGNATURE_WHEN_GOVERNING_PROFILE_REQUIRES",
  "x-state-domain": null,
  "x-closed": true
