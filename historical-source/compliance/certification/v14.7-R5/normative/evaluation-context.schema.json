{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-discovery-engine.invalid/v14.7-R5/normative_specification/evaluation-context.schema.json",
  "title": "evaluation-context",
  "type": "object",
  "required": [
