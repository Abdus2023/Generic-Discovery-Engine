{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-discovery-engine.invalid/v14.7-R4/event",
  "title": "event",
  "type": "object",
  "required": [
    "event_id",
    "stream_id",
    "sequence_no",
    "predecessor_ref",
    "event_type",
    "payload_hash",
    "validated",
    "committed",
    "content_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence_no": {
      "type": "integer",
      "minimum": 0
    },
    "predecessor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validated": {
      "type": "boolean"
    },
    "committed": {
      "type": "boolean"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "x-immutable": true,
  "x-profile": "gde-v14.7-r4-runtime@14.7-R4",
  "x-normative-rules": [
    "unvalidated event forbidden from history"
  ]
}
