+// ==UserScript==
+// @name         Generic Discovery Engine
+// @namespace    generic-discovery
+// @version      0.3.0
+// @description  Generic web-resource discovery prototype inspired by the architecture of DVB blind scanning.
+// @match        *://*/*
+// @grant        GM_getValue
+// @grant        GM_setValue
+// @grant        GM_xmlhttpRequest
+// @connect      *
+// ==/UserScript==
+
+(() => {
+    'use strict';
+
+    /* =====================================================================
+     * GENERIC DISCOVERY ENGINE v0.3.0
+     * =====================================================================
+     *
+     * Architecture:
+     *
+     *     candidate
+     *         ↓
+     *     acquisition
+     *         ↓
+     *     observation
+     *         ↓
+     *     recognition
+     *         ↓
+     *     discovery
+     *         ↓
+     *     new candidates
+     *         ↓
+     *     scheduler
+     *
+     * This is NOT a DVB/RF scanner.
+     *
+     * It does not:
+     *   - access RF hardware
+     *   - tune frequencies
+     *   - synchronize carriers
+     *   - perform FEC synchronization
+     *   - demodulate DVB signals
+     *
+     * Instead, it applies a similar discovery architecture to web
+     * resources:
+     *
+     *     URL → HTTP response → provider → discovered metadata → URLs
+     *
+     * Supported providers:
+     *   - HTML
+     *   - JSON
+     *   - text
+     *
+     * v0.3.0 improvements:
+     *   - Correct relative URL resolution for fetched documents
+     *   - Atomic candidate claiming
+     *   - Retry with bounded attempts
+     *   - Better fetch timeout handling
+     *   - Improved Content-Type parsing
+     *   - More HTML resource types
+     *   - Canonical/meta-refresh discovery
+     *   - URL extraction from JSON and text
+     *   - Bounded persisted state
+     *   - Live progress UI
+     *   - Per-run statistics reset
+     *   - Safer DOM/UI handling
+     *   - Explicit provider interface
+     * ===================================================================== */
+
+
+    // =====================================================================
+    // CONFIGURATION
+    // =====================================================================
+
+    const CONFIG = {
+        maxCandidates: 500,
+        maxRequests: 100,
+
+        concurrency: 3,
+
+        requestTimeout: 8000,
+
+        /*
+         * Keep this true unless you intentionally want cross-origin
+         * discovery. Cross-origin requests also depend on userscript
+         * manager permissions and remote server behavior.
+         */
+        sameOriginOnly: true,
+
+        discoverLinks: true,
+        discoverResources: true,
+        discoverForms: true,
+        discoverMetadata: true,
+        discoverFromText: true,
+
+        /*
+         * Number of times an acquisition may be retried after failure.
+         */
+        maxRetries: 1,
+
+        /*
+         * State persistence can become large on long-running scans.
+         */
+        persistState: true,
+        maxPersistedDiscoveries: 1000,
+
+        debug: true
+    };
+
+
+    // =====================================================================
+    // LOGGING / UTILITIES
+    // =====================================================================
+
+    const log = (...args) => {
+        if (CONFIG.debug) {
+            console.log('[Discovery]', ...args);
+        }
+    };
+
+    const warn = (...args) => {
+        console.warn('[Discovery]', ...args);
+    };
+
+    const now = () => Date.now();
+
+    function makeId(prefix = 'id') {
+        return `${prefix}-${now()}-${Math.random()
+            .toString(36)
+            .slice(2, 9)}`;
+    }
+
+    function unique(values) {
+        return [...new Set(values)];
+    }
+
+    function canonicalizeUrl(value, baseUrl = location.href) {
+        if (!value || typeof value !== 'string') {
+            return null;
+        }
+
+        const trimmed = value.trim();
+
+        if (!trimmed) {
+            return null;
+        }
+
+        /*
+         * Ignore non-fetchable schemes.
+         */
