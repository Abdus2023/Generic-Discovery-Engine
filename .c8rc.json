{
  "all": true,
  "include": [
    "src/**/*.js",
    "dist/generic-discovery-engine.user.js"
  ],
  "exclude": [
    "tests/**",
    "scripts/**",
    "dist/*.v*.user.js",
    "coverage/**",
    "node_modules/**"
  ],
  "reporter": [
    "text",
    "html",
    "lcov"
  ],
  "check-coverage": true,
  "lines": 0,
  "branches": 0,
  "functions": 0,
  "per-file": false
}
